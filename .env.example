# Server
PORT=3001
CLIENT_URL=https://looks-maxing.ru
JWT_SECRET=change-me-to-random-secret-key

# Ручное начисление mogгов (длинный случайный пароль, только для тебя)
ADMIN_SECRET=your-long-random-secret

# OpenAI (опционально — для расширенного AI-вердикта)
OPENAI_API_KEY=

# ЮKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Мой налог — авточеки (пароль от входа в ЛК ФНС / lknpd.nalog.ru)
NALOG_INN=027370199139
NALOG_PASSWORD=your_nalog_login_password
NALOG_DEVICE_ID=optional-fixed-uuid

# Robokassa (запасной вариант, если ЮKassa не настроена)
ROBOKASSA_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=password_1
ROBOKASSA_PASSWORD2=password_2
ROBOKASSA_TEST=true
